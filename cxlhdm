sub get_hb_root_ports_str {
    my ($cxl_hb) = @_;

    if (!scalar @{$cxl_hb->{rports}}) {
        return "rports:{${RED}<?>${RESET}}";
    }

    my $str = sprintf("rports:{");
    my $bdf = "";
    foreach my $i (0 .. $#{$cxl_hb->{rports}} - 1) {
        my $rp = $cxl_hb->{rports}[$i];
        $bdf = $rp->{bdf};
        $str .= sprintf("%s", $bdf eq "<?>" ? "${RED}<?>${RESET}," : "${PURPLE}${bdf}${RESET},");
    }
    my $rp = $cxl_hb->{rports}[-1];
    $bdf = $rp->{bdf};
    $str .= sprintf("%s", $bdf eq "<?>" ? "${RED}<?>${RESET}}" : "${PURPLE}${bdf}${RESET}}");
    return $str;
}

# cxl_hbs[]
#
# cxl_hb
#   - uid
#   - ver
#   - chbs_base
#   - chbs_len
#   - hdm_cnt
#   - hdm_base
#   - rports[]
#   - has_mem
#
# rport
#   - bdf
#   - mems[]
#
# cxl_memdev
#   - bdf
#   - mem           memX
#   - is_memdev
#   - size
#   - parent_hb     $cxl_hb
sub scan_cxl_host_bridge {
    make_cedt_dsl();
    open my $fh, '<', 'CEDT.dsl' or die "${RED}can't open CEDT.dsl!!!${RESET}";
    my @cedt_lines = <$fh>;
    close $fh;

    my $tmp_hb = {};
    foreach my $line (@cedt_lines) {
        chomp $line;
        next if $line =~ /^\s*$/;

        if ($line =~ /CXL Host Bridge Structure/) {
            if (defined $tmp_hb->{uid}) {
                push @cxl_hbs, $tmp_hb;
                $tmp_hb = {};
            }
        } elsif ($line =~ /Associated host bridge : ([0-9A-F]+)/i) {
            $tmp_hb->{uid} = hex($1);
        } elsif ($line =~ /Specification version : ([0-9A-F]+)/i) {
            $tmp_hb->{ver} = hex($1);
        } elsif ($line =~ /Register base : ([0-9A-F]+)/i) {
            $tmp_hb->{chbs_base} = hex($1);
        } elsif ($line =~ /Register length : ([0-9A-F]+)/i) {
            $tmp_hb->{chbs_len} = hex($1);
        }
    }
    push @cxl_hbs, $tmp_hb if defined $tmp_hb->{uid};

    foreach my $cxl_hb (@cxl_hbs) {
        $cxl_hb->{is_memdev} = 0;
        $cxl_hb->{rports} = [];

        my $cxl_ver = "";
        my $CXL_HDM_BASE = 0;
        if ($cxl_hb->{ver} == 1) { # CXL 2.0+
            $cxl_ver = "${GREEN}CXL 2.X${RESET}";

            my $bus_num = "<?>";
            my $acpi = 'ACPI0016:<?>';
            my $port = "port<?>";
            my @port_dirs = glob("/sys/bus/cxl/devices/port[0-9]");
            foreach my $port_dir (@port_dirs) {
                next unless ($port_dir && -d $port_dir);
                my $uid = "<?>";
                if (readlink("$port_dir/uport")) {
                    $bus_num = basename(readlink("$port_dir/uport"));
                }
                if (readlink("/sys/devices/$bus_num/firmware_node")) {
                    $acpi = basename(readlink("/sys/devices/$bus_num/firmware_node"));
                    $uid = cat_sysfs_file("/sys/bus/acpi/devices/$acpi/uid");
                }
                next unless $uid == $cxl_hb->{uid};

                $port = basename($port_dir);
                last;
            }
            $cxl_hb->{bus_num} = $bus_num;
            $cxl_hb->{acpi} = $acpi;
            $cxl_hb->{port} = $port;

            # 遍历 dport 解析 RP BDF 和 memdev
            if ($port ne "port<?>") {
                my @dport_paths = glob("/sys/bus/cxl/devices/${port}/dport*");
                foreach my $dport_path (@dport_paths) {
                    next unless ($dport_path && -d $dport_path);
                    my $dport = basename($dport_path);

                    my $rport = { };
                    $rport->{bdf} = readlink("$dport_path") ? basename(readlink("$dport_path")) : '<?>';
                    push @{$cxl_hb->{rports}}, $rport;
                    next if $rport->{bdf} eq '<?>';

                    $rport->{mems} = [];
                    my @memdev_bdf_paths = glob("$dport_path/*:*:*.[0-9]");
                    foreach my $memdev_bdf_path (@memdev_bdf_paths) {
                        # only 1 memdev for 1 bdf
                        my $mem_path = (glob("$memdev_bdf_path/mem[0-9]"))[0];
                        next unless ($mem_path && -d $mem_path);

                        my $cxl_memdev = { };
                        $cxl_memdev->{bdf} = basename($memdev_bdf_path);
                        $cxl_memdev->{mem} = basename($mem_path);
                        $cxl_memdev->{is_memdev} = 1;
                        my $size_file = "/sys/bus/pci/devices/$cxl_memdev->{bdf}/$cxl_memdev->{mem}/ram/size";
                        $cxl_memdev->{size} = hex(cat_sysfs_file($size_file)) & hex("fffffffff0000000");
                        $cxl_memdev->{parent_hb} = $cxl_hb;
                        # don't add mem if no hdm decoder
                        next unless scan_cxl2_X_type3_dev($cxl_memdev) == 0;
                        push @{$rport->{mems}}, $cxl_memdev;
                        $cxl_hb->{has_mem} = 1;
                    }
                }
            }

            my $cachemem_pri_base = $cxl_hb->{chbs_base} + 0x1000;
            my $cap_cnt = (read_devmem($cachemem_pri_base, 32) >> 24);
            for (my $addr = $cachemem_pri_base; $addr <= $cachemem_pri_base + $cap_cnt * 4; $addr += 4) {
                my $data = read_devmem($addr, 32);
                if (($data & 0xffff) == 5) {
                    $CXL_HDM_BASE = $cachemem_pri_base + ($data >> 20);
                    last;
                }
            }
            $cxl_hb->{hdm_base} = $CXL_HDM_BASE;
            if ($CXL_HDM_BASE) {
                init_hdmdec($cxl_hb);
            } else {
                $cxl_hb->{hdm_cnt} = 0;
            }
        } elsif ($cxl_hb->{ver} == 0) { # CXL 1.1
            $cxl_ver = "${GREEN}CXL 1.1${RESET}";
            my $rcrb_base = $cxl_hb->{chbs_base};
            my $rcrb_dp_base = $rcrb_base;
            my $rcrb_up_base = $rcrb_base + 0x1000;
            my $rcrb_up_base_data = read_devmem($rcrb_up_base, 32);
            if ($rcrb_up_base_data == 0xffffffff) {
                printf("%s: CXL Device that Does Not Remap Upstream Port and Component Registers\n", $cxl_ver) if $g_debug;
            } else {
                printf("%s: CXL Device Remaps Upstream Port and Component Registers\n", $cxl_ver) if $g_debug;
            }
            my $rcrb_dp_membar0_l = read_devmem($rcrb_dp_base + 0x10, 32) & 0xfffffff0;
            my $rcrb_dp_membar0_h = read_devmem($rcrb_dp_base + 0x14, 32);
            my $rcrb_dp_membar0 = ($rcrb_dp_membar0_h << 32) | $rcrb_dp_membar0_l;
            my $cachemem_pri_base = $rcrb_dp_membar0 + 0x1000;
            my $cap_cnt = read_devmem($cachemem_pri_base, 32) >> 24;
            $cxl_hb->{hdm_base} = 0;
            $cxl_hb->{hdm_cnt} = 0;

            my $bus_num = "<?>";
            my $acpi = 'ACPI0016:<?>';
            my $port = "port<?>";
            my @dport_paths = glob("/sys/bus/cxl/devices/root0/dport[0-9]*");
            foreach my $dport_path (@dport_paths) {
                next unless ($dport_path && -d $dport_path);
                my $uid = "<?>";
                if (readlink("$dport_path")) {
                    $bus_num = basename(readlink("$dport_path"));
                }
                if (readlink("/sys/devices/$bus_num/firmware_node")) {
                    $acpi = basename(readlink("/sys/devices/$bus_num/firmware_node"));
                    $uid = cat_sysfs_file("/sys/bus/acpi/devices/$acpi/uid");
                }
                next unless $uid == $cxl_hb->{uid};

                $port = basename($dport_path);
                my $rport = { };
                $rport->{bdf} = $bus_num;
                push @{$cxl_hb->{rports}}, $rport;
                last if $rport->{bdf} eq '<?>';

                $rport->{mems} = [];
                my @memdev_bdf_paths = glob("$dport_path/*:*:*.[0-9]");
                foreach my $memdev_bdf_path (@memdev_bdf_paths) {
                    # only 1 memdev for 1 bdf
                    my $mem_path = (glob("$memdev_bdf_path/mem[0-9]"))[0];
                    next unless ($mem_path && -d $mem_path);

                    my $cxl_memdev = { };
                    $cxl_memdev->{bdf} = basename($memdev_bdf_path);
                    $cxl_memdev->{mem} = basename($mem_path);
                    $cxl_memdev->{is_memdev} = 1;
                    my $size_file = "/sys/bus/pci/devices/$cxl_memdev->{bdf}/$cxl_memdev->{mem}/ram/size";
                    $cxl_memdev->{size} = hex(cat_sysfs_file($size_file)) & hex("fffffffff0000000");
                    $cxl_memdev->{parent_hb} = $cxl_hb;
                    # don't add mem if no hdm decoder
                    next unless scan_cxl2_X_type3_dev($cxl_memdev) == 0;
                    push @{$rport->{mems}}, $cxl_memdev;
                    $cxl_hb->{has_mem} = 1;
                    printf("%s\n", $cxl_memdev->{name}) if $g_debug;
                }

                last;
            }
            $cxl_hb->{bus_num} = $bus_num;
            $cxl_hb->{acpi} = $acpi;
            $cxl_hb->{port} = $port;
        }

        my $rports_str = get_hb_root_ports_str($cxl_hb);
        if ($cxl_hb->{port} eq "port<?>") {
            $cxl_hb->{name} = sprintf("${RED}%s %s %s${RESET} CXL Host Bridge: uid:%#lx %s %s:%lx-%lx HDM_BASE %#lx %s",
                $cxl_hb->{port}, $cxl_hb->{acpi}, $cxl_hb->{bus_num}, $cxl_hb->{uid}, $cxl_ver, $cxl_hb->{ver} == 0 ? "RCRB" : "CHBCR",
                $cxl_hb->{chbs_base}, $cxl_hb->{chbs_base} + $cxl_hb->{chbs_len} - 1, $cxl_hb->{hdm_base}, $rports_str);
        } else {
            $cxl_hb->{name} = sprintf("${PURPLE}%s %s %s${RESET} CXL Host Bridge: uid:${ORANGE}%#lx${RESET} %s %s:%lx-%lx HDM_BASE %#lx %s",
                $cxl_hb->{port}, $cxl_hb->{acpi}, $cxl_hb->{bus_num}, $cxl_hb->{uid}, $cxl_ver, $cxl_hb->{ver} == 0 ? "RCRB" : "CHBCR",
                $cxl_hb->{chbs_base}, $cxl_hb->{chbs_base} + $cxl_hb->{chbs_len} - 1, $cxl_hb->{hdm_base}, $rports_str);
        }
        printf("%s\n", $cxl_hb->{name}) if $g_debug;
    }
}

sub dump_cxl_hdmdec {
    my ($mem) = @_;
    if ($mem) {
        foreach my $cxl_hb (@cxl_hbs) {
            next if (!$g_verbose && ((!scalar @{$cxl_hb->{rports}}) || !$cxl_hb->{hdm_cnt}));
            foreach my $rport (@{$cxl_hb->{rports}}) {
                foreach my $i (0 .. $#{$rport->{mems}}) {
                    my $cxl_memdev = $rport->{mems}[$i];
                    next if ($cxl_memdev->{mem} ne $mem);

                    $i == 0 ? printf("\\--- ") : printf("     ");
                    printf "$rport->{mems}[$i]->{name}\n";
                    dump_hdmdec($cxl_memdev, 0);
                }
            }
        }
    } else {
        dump_cfmw_decoder();
        foreach my $cxl_hb (@cxl_hbs) {
            next if (!$g_verbose && ((!scalar @{$cxl_hb->{rports}}) || !$cxl_hb->{has_mem}));

            printf "$cxl_hb->{name}\n";
            dump_hdmdec($cxl_hb) if $cxl_hb->{hdm_cnt};

            foreach my $rport (@{$cxl_hb->{rports}}) {
                foreach my $i (0 .. $#{$rport->{mems}}) {
                    my $cxl_memdev = $rport->{mems}[$i];
                    $i == 0 ? printf("\\--- ") : printf("     ");
                    printf "$cxl_memdev->{name}\n";
                    dump_hdmdec($cxl_memdev, 0);
                }
            }
        }
    }
}

sub do_subcmd_commit {
    my (@args) = @_;
    my ($base, $size, $mem_name, $port_name, $ig, $iw, $decoder_idx, $verbose, $help);

    Getopt::Long::Configure('pass_through');
    Getopt::Long::GetOptionsFromArray(
        \@args,
        'base|b=s'     => \$base,
        'size|s=s'     => \$size,
        'mem|m=s'      => \$mem_name,
        'port|p=s'     => \$port_name,
        'decoder|d=i'  => \$decoder_idx,
        'ig|g=i'       => \$ig,
        'iw|w=i'       => \$iw,
        'verbose|v'    => \$verbose,
        'help|h'       => \$help,
    ) or do {
        printf("${RED}invalid input!!!${RESET}\n");
        return 1;
    };

    if ($help) {
        print "$USAGE\n";
        return 0;
    }

    $base //= 0;
    $size //= 0;
    $ig //= 0;
    $iw //= 0;
    $decoder_idx //= 0;
    $g_verbose = 1 if $verbose;

    if (!$mem_name && !$port_name) {
        printf("${RED}need <-m memX|-p portX> [-d decoder_idx] [-w iw] [-g ig] [-b hpa_base] [-s hpa_size] parameter!!!${RESET}\n");
        return 1;
    }
    if (($iw > 4 && $iw < 8) || $iw > 10 || $ig > 6) {
        printf("${RED}invalid ig=%d iw=%d!!!${RESET}\n", $ig, $iw);
        return 1;
    }
    if ($size && $size % 0x10000000 != 0) {
        printf("${RED}invalid size=%#lx, must be a multiple of 0x10000000!!!${RESET}\n", $size);
        return 1;
    }
    if ($iw >=8 && $iw <=10 && ($size >> 28) %3 != 0) {
        printf("${RED}invalid size=%#lx for iw=%d, must be a multiple of 0x30000000!!!${RESET}\n", $size, $iw);
        return 1;
    }
    if ($decoder_idx > 4) {
        printf("${RED}invalid decoder idx:%d, must smaller than 4!!!${RESET}\n", $decoder_idx);
        return 1;
    }

    scan_cxl_host_bridge();
    if ($mem_name) {
        foreach my $dev (@cxl_type3_devs) {
            if ($dev->{mem} eq $mem_name) {
                return commit_hdmdec($dev, $decoder_idx, $ig, $iw, hex($base), hex($size));
            }
        }
    } else {
        foreach my $dev (@cxl_hbs) {
            if ($dev->{port} eq $port_name) {
                return commit_hdmdec($dev, $decoder_idx, $ig, $iw, hex($base), hex($size));
            }
        }
    }

    my $not_found = $mem_name ? $mem_name : $port_name;
    printf("${RED}can found %s!!!${RESET}\n", $not_found);
    return 1;
}

sub do_subcmd_clear {
    my (@args) = @_;
    my ($mem_name, $port_name, $decoder_idx, $verbose, $help);

    Getopt::Long::Configure('pass_through');
    Getopt::Long::GetOptionsFromArray(
        \@args,
        'mem|m=s'      => \$mem_name,
        'port|p=s'     => \$port_name,
        'decoder|d=i'  => \$decoder_idx,
        'verbose|v'    => \$verbose,
        'help|h'       => \$help,
    ) or do {
        printf("${RED}invalid input!!!${RESET}\n");
        return 1;
    };

    if ($help) {
        print "$USAGE\n";
        return 0;
    }

    $decoder_idx //= 0;
    $g_verbose = 1 if $verbose;

    if (!$mem_name && !$port_name) {
        printf("${RED}need <-m memX|-p portX> [-d decoder_idx] parameter!!!${RESET}\n");
        return 1;
    }
    if ($decoder_idx > 4) {
        printf("${RED}invalid decoder idx:%d, must smaller than 4!!!${RESET}\n", $decoder_idx);
        return 1;
    }

    scan_cxl_host_bridge();
    if ($mem_name) {
        foreach my $dev (@cxl_type3_devs) {
            if ($dev->{mem} eq $mem_name) {
                return clear_hdmdec_commit($dev, $decoder_idx);
            }
        }
    } else {
        foreach my $dev (@cxl_hbs) {
            if ($dev->{port} eq $port_name) {
                return clear_hdmdec_commit($dev, $decoder_idx);
            }
        }
    }

    my $not_found = $mem_name ? $mem_name : $port_name;
    printf("${RED}can found %s!!!${RESET}\n", $not_found);
    return 1;
}

sub do_loop_test {
    scan_cxl_host_bridge();
    my $loop = 1;
    while (1) {
        printf "====================== $loop ==================\n";
        foreach my $dev (@cxl_type3_devs) {
            for my $iw (0..4) {
                for my $ig (0..6) {
                    commit_hdmdec($dev, 0, $ig, $iw);
                }
            }
            if ($zebu) {
                for my $iw (8..10) {
                    for my $ig (0..6) {
                        commit_hdmdec($dev, 0, $ig, $iw);
                    }
                }
            }
        }
        $loop++;
    }
    exit 0;
}

sub main() {
    my $lscpu_out = qx/lscpu/;
    my ($hypervisor) = $lscpu_out =~ /Hypervisor vendor\s+:\s+(\w+)/;
    if ($hypervisor && $hypervisor eq 'KVM') {
        $zebu = 1;
        $COMMIT_TIMEOUT_MS = 10000;
    } else {
        $zebu = 0;
        $COMMIT_TIMEOUT_MS = 300;
    }

    my $subcmd = shift @ARGV;
    if (!$subcmd || $subcmd eq '-v' || $subcmd eq '-m') {
        $g_verbose = 1 if defined $subcmd && $subcmd eq '-v';
        scan_cxl_cfmw();
        scan_cxl_host_bridge();
        dump_cxl_hdmdec(@ARGV);
        return 0;
    } elsif ($subcmd eq 'commit') {
        return do_subcmd_commit(@ARGV);
    } elsif ($subcmd eq 'clear') {
        return do_subcmd_clear(@ARGV);
    } elsif ($subcmd eq '-t') {
        return do_loop_test();
    } elsif ($subcmd eq '-h' || $subcmd eq '--help') {
        print "$USAGE\n";
        return 0;
    } else {
        printf "%sinvalid subcommand!!!%s\n", $RED, $RESET;
        print "$USAGE\n";
        return 1;
    }

    return 0;
}

main();
