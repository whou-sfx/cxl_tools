sub scan_cxl2_X_type3_dev {
    my ($cxl_memdev) = @_;
    my $bdf = $cxl_memdev->{bdf};
    my $mem = $cxl_memdev->{mem};
    my $lspci_out = qx/lspci -s $bdf -vvv 2>\/dev\/null/;
    my ($hdmrange_cnt) = $lspci_out =~ /HDMCount\s+(\d+)/;
    return -1 if !$hdmrange_cnt;

    my ($bar_num) = $lspci_out =~ /BIR:\s*bar(\d+),.*component registers/;
    my ($comp_bar_addr) = $lspci_out =~ /Region ${bar_num}: Memory at ([0-9a-f]+)/i;
    my ($comp_reg_off) = $lspci_out =~ /.*component registers, offset: ([0-9a-f]+)/i;
    my $comp_reg_base = hex($comp_bar_addr) + hex($comp_reg_off);
    my $cachemem_pri_base = $comp_reg_base + 0x1000;

    my $cxl_hdm_base = 0;
    my $cap_cnt = (read_devmem($cachemem_pri_base, 32) >> 24);
    for (my $addr = $cachemem_pri_base; $addr <= $cachemem_pri_base + $cap_cnt * 4; $addr +=4) {
        my $data = read_devmem($addr, 32);
        if (($data & 0xffff) == 5) {
            $cxl_hdm_base = $cachemem_pri_base + ($data >> 20);
            last;
        }
    }
    if ($cxl_hdm_base == 0) {
        printf("${RED}%s: can't found HDM decoder!!!${RESET}\n", $bdf);
        return -1;
    }
    $cxl_memdev->{hdm_base} = $cxl_hdm_base;

    # 匹配 endpoint 端口
    my @endpoint_dirs = glob("/sys/bus/cxl/devices/endpoint[0-9]*");
    foreach my $ep_dir (@endpoint_dirs) {
        next unless ($ep_dir && -d $ep_dir);
        my $uport = readlink("$ep_dir/uport");
        my $tmp_mem = $uport ? basename($uport) : "";
        if ($tmp_mem eq $mem) {
            $cxl_memdev->{port} = basename($ep_dir);
            last;
        }
    }
    $cxl_memdev->{port} //= "endpoint<?>";

    init_hdmdec($cxl_memdev);

    if ($cxl_memdev->{port} eq "endpoint<?>") {
        $cxl_memdev->{name} = sprintf("${PURPLE}%s %s ${RED}%s${RESET} CXL Type3 Device: HDM_BASE %#lx", $cxl_memdev->{mem}, $cxl_memdev->{bdf}, $cxl_memdev->{port}, $cxl_hdm_base);
    } else {
        $cxl_memdev->{name} = sprintf("${PURPLE}%s %s %s${RESET} CXL Type3 Device: HDM_BASE %#lx", $cxl_memdev->{mem}, $cxl_memdev->{bdf}, $cxl_memdev->{port}, $cxl_hdm_base);
    }

    push @cxl_type3_devs, $cxl_memdev;
    return 0;
}

sub make_cedt_dsl() {
    unlink "CEDT.dsl" if -e "CEDT.dsl";
    if (-e "/sys/firmware/acpi/tables/CEDT") {
        system("cp /sys/firmware/acpi/tables/CEDT . >/dev/null 2>&1");
        system("iasl CEDT >/dev/null 2>&1");
        unlink "CEDT" if -e "CEDT";
    } else {
        system("acpidump -b >/dev/null 2>&1");
        my $ret = system("iasl cedt.dat >/dev/null 2>&1");
        unlink glob("*.dat");
        if ($ret != 0) {
            die("${RED}No CEDT!!!${RESET}\n");
        }
    }
}

