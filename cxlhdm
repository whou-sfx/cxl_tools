my $RESET   = "\033[0m";

my $GREEN   = "\033[32m";
my $YELLOW  = "\033[33m$BOLD";
my $PURPLE  = "\033[34m$BOLD";
my $BLUE    = "\033[36m$BOLD";
my $ORANGE  = "\033[38;5;208m";
