sub scan_cxl_cfmw() {
    make_cedt_dsl();
    open my $fh, '<', 'CEDT.dsl' or die "${RED}can't open CEDT.dsl!!!${RESET}";
    my @cedt_lines = <$fh>;
    close $fh;

    my $cfmw_decoder_cnt = 0;
    my $cfmw_decoder = {};
    foreach my $line (@cedt_lines) {
        chomp $line;
        next if $line =~ /^\s*$/;

        if ($line =~ /CXL Fixed Memory Window Structure/) {
            if ($cfmw_decoder->{base}) {
                $cfmw_decoder->{hid} = $cfmw_decoder_cnt;
                $cfmw_decoder_cnt++;
                push @{$cxl_cfmws->{decoders}}, $cfmw_decoder;
                $cfmw_decoder = {};
            }
        } elsif ($line =~ /Window base address : ([0-9A-F]+)/i) {
            $cfmw_decoder->{base} = hex($1);
        } elsif ($line =~ /Window size : ([0-9A-F]+)/i) {
            $cfmw_decoder->{size} = hex($1);
        } elsif ($line =~ /Interleave Members(?: \(2\^n\))? : ([0-9A-F]+)/i) {
            $cfmw_decoder->{iw} = hex($1);
        } elsif ($line =~ /Interleave Arithmetic : ([0-9A-F]+)/i) {
            $cfmw_decoder->{ari} = hex($1);
        } elsif ($line =~ /Granularity : ([0-9A-F]+)/i) {
            $cfmw_decoder->{ig} = hex($1);
        } elsif ($line =~ /Restrictions : ([0-9A-F]+)/i) {
            $cfmw_decoder->{restrictions} = hex($1);
        } elsif ($line =~ /QtgId : ([0-9A-F]+)/i) {
            $cfmw_decoder->{qtgid} = hex($1);
        } elsif (($line =~ /First Target : ([0-9A-F]+)/i) || ($line =~ /Next Target : ([0-9A-F]+)/i)) {
            push @{$cfmw_decoder->{targets}}, hex($1);
            $cfmw_decoder->{target_cnt}++;
        }
    }
    if ($cfmw_decoder->{base}) {
        $cfmw_decoder->{hid} = $cfmw_decoder_cnt;
        $cfmw_decoder_cnt++;
        push @{$cxl_cfmws->{decoders}}, $cfmw_decoder;
    }

    my $root_dir = "/sys/bus/cxl/devices/root0";
    my $uport = readlink("$root_dir/uport");
    my $acpi = $uport ? basename($uport) : '';
    $cxl_cfmws->{root} = basename($root_dir);
    $cxl_cfmws->{acpi} = $acpi;

    foreach my $cfmw_decoder (@{$cxl_cfmws->{decoders}}) {
        $cfmw_decoder->{regions} = [];
        $cfmw_decoder->{daxs} = [];
        my $decoder_dir = (glob("/sys/bus/cxl/devices/$cxl_cfmws->{root}/decoder0.$cfmw_decoder->{hid}"))[0];
        if ($decoder_dir) {
            $cfmw_decoder->{decoder} = basename($decoder_dir);
            my @region_dirs = glob("$decoder_dir/region*");
            foreach my $region_dir (@region_dirs) {
                push @{$cfmw_decoder->{regions}}, basename($region_dir);
                my @dax_dirs = glob("$region_dir/dax_region[0-9]*/dax[0-9]*");
                foreach my $dax_dir (@dax_dirs) {
                    next unless $dax_dir;
                    push @{$cfmw_decoder->{daxs}}, basename($dax_dir);
                    last;
                }
            }
        } else {
            $cfmw_decoder->{decoder} = 'decoder<?>';
        }
    }

    if (!$cxl_cfmws->{root}) {
        $cxl_cfmws->{root} = "root<?>";
        $cxl_cfmws->{acpi} = "ACPI0017:<?>";
        $cxl_cfmws->{name} = sprintf("${RED}%s %s${RESET} CXL Fixed Memory Window", $cxl_cfmws->{root}, $cxl_cfmws->{acpi});
    } else {
        $cxl_cfmws->{name} = sprintf("${PURPLE}%s %s${RESET} CXL Fixed Memory Window", $cxl_cfmws->{root}, $cxl_cfmws->{acpi});
    }
    #printf("$cxl_cfmws->{name}\n");
}

