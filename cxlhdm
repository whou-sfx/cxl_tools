sub flag_to_color_str {
    my ($str, $data, $bit, $color_if_set, $color_if_not_set) = @_;
    if ($data & (1 << $bit)) {
        if ($color_if_set) {
            return "${color_if_set}${str}+${RESET}";
        } else {
            return "${str}+";
        }
    } else {
        if ($color_if_not_set) {
            return "${color_if_not_set}${str}-${RESET}";
        } else {
            return "${GRAY}${str}-${RESET}";
        }
    }
}

sub num_to_color_str {
    my ($str, $num) = @_;
    if ($num) {
        return sprintf("%s=%d", $str, $num),
    } else {
        return sprintf("${GRAY}%s=%d${RESET}", $str, $num),
    }
}

sub dump_hb_iw_rp_targets {
    my ($targets_ref, $color) = @_;
    printf("iwRpTargets={");
    for my $i (0 .. $#$targets_ref-1) {
        if ($color) {
            printf("${color}%#lx${RESET},", $targets_ref->[$i]);
        } else {
            printf("%#lx,", $targets_ref->[$i]);
        }
    }
    if ($color) {
        printf("${color}%#lx${RESET}} ", $targets_ref->[-1]);
    } else {
        printf("%#lx}", $targets_ref->[-1]);
    }
}

sub printf_prefix {
    printf $_[0] ? "     |" : "|";
}

sub size_to_human_string {
    my ($size) = @_;
    my $str = qx/numfmt --to=iec --format="%.2f" $size/;
    chomp $str;
    return $str;
}

sub read_devmem {
    my ($addr, $width) = @_;
    my $val = qx/busybox devmem $addr $width/;
    chomp $val;
    $val = hex($val);
    #printf("%#lx=busybox devmem $addr $width\n", $val);
    return $val;
}

sub write_devmem {
    my ($addr, $width, $val) = @_;
    system("busybox devmem $addr $width $val >/dev/null 2>&1");
}

sub cat_sysfs_file {
    my ($path_file) = @_;
    my $str = qx/cat $path_file/;
    chomp $str;
    return $str;
}

sub basename {
    my ($path) = @_;
    my $str = (split '/', $path)[-1];
    return $str;
}

my @coh_model_str = (
    "${RED}unknown${RESET}",
    "${RED}Device Coh${RESET}",
    "HDM-H",
    "HDM-H or ${RED}HDM-D/HDM-DB${RESET}",
);
my @target_range_type_str = ( "${RED}HDM-D/HDM-DB${RESET}", "HDM-H" );
sub dump_hdmdec {
    my ($cxl_port) = @_;
    my $hdm_base = $cxl_port->{hdm_base};
    my $name = $cxl_port->{name};
    my $port = $cxl_port->{port};
    my $is_memdev = $cxl_port->{is_memdev};

    my $cap = read_devmem($hdm_base, 32);
    my $gbl_ctl = read_devmem($hdm_base + 0x4, 32);
    my ($hdm_cnt, $tag_cnt) = ($cxl_port->{hdm_cnt}, ($cap & 0xf0) >> 4);

    printf_prefix($is_memdev);
    my $uio = $cap & (1 << 13);
    printf("    %-40s %d-Decoders %s%s %s %s %s %s %s %s%s SupCohModels:%s\n",
        "HDMCap ", $hdm_cnt, $is_memdev ? "" : sprintf("%d-Tgts ", $tag_cnt),
        flag_to_color_str("A11to8", $cap, 8, "", $is_memdev ? "" : $RED),
        flag_to_color_str("A14to12", $cap, 9, "", $is_memdev ? "" : $RED),
        flag_to_color_str("PoisonOnDecErr", $cap, 10),
        flag_to_color_str("Iw3,6,12", $cap, 11, $is_memdev ? "" : $RED),
        flag_to_color_str("Iw16", $cap, 12, $is_memdev ? "" : $RED),
        flag_to_color_str("Uio", $cap, 13),
        !$uio ? "" : num_to_color_str("UioCnt ", ($cap >> 16) & 0xf),
        flag_to_color_str("MemDataNXM", $cap, 20),
        $coh_model_str[($cap >> 21) & 3]);

    printf_prefix($is_memdev);
    printf("    %-40s %s %s\n", "HDMGblCtl ",
        flag_to_color_str("PoisonOnDecErrEn", $gbl_ctl, 0),
        $is_memdev ? flag_to_color_str("HDMDecEn", $gbl_ctl, 1) : "");

    if ($hdm_cnt == 0) {
        printf_prefix($is_memdev);
        printf("    ${RED}Can't found HDM decoder!!!${RESET}\n\n");
        return;
    }

    for my $hid (0 .. $hdm_cnt-1) {
        my $size_l = read_devmem($hdm_base + $hid * 0x20 + 0x18, 32);
        my $size_h = read_devmem($hdm_base + $hid * 0x20 + 0x1c, 32);
        my $size = ($size_h << 32) | $size_l;
        next if !$size && !$g_verbose;

        my ($print_err, $print_ok) = (0, 0);
        my $base_l = read_devmem($hdm_base + $hid * 0x20 + 0x10, 32);
        my $base_h = read_devmem($hdm_base + $hid * 0x20 + 0x14, 32);
        my $base = ($base_h << 32) | $base_l;
        my $ctl = read_devmem($hdm_base + $hid * 0x20 + 0x20, 32);
        my $skip_l = read_devmem($hdm_base + $hid * 0x20 + 0x24, 32);
        my $skip_h = read_devmem($hdm_base + $hid * 0x20 + 0x28, 32);
        my $skip = ($skip_h << 32) | $skip_l;

        my @iw_rp_targets;
        if (!$is_memdev) {
            my $rp_list = $skip;
            my $iw = ($ctl & 0xf0) >> 4;

            my $rp_cnt = scalar @{$cxl_port->{rports}};
            push @iw_rp_targets, $rp_list & 0xff;
            if ($iw >= 1 && $rp_cnt >= 2) {
                push @iw_rp_targets, ($rp_list >> 8) & 0xff;
                if ($iw >= 2 && $rp_cnt >= 4) {
                    push @iw_rp_targets, ($rp_list >> 16) & 0xff, ($rp_list >> 24) & 0xff;
                    if ($iw >= 3 && $rp_cnt >= 8) {
                        push @iw_rp_targets, ($rp_list >> 32) & 0xff, ($rp_list >> 40) & 0xff, ($rp_list >> 48) & 0xff, ($rp_list >> 56) & 0xff;
                    }
                }
            }
        }

        my ($decoder, $dax, $dax_mode, $region) = (
            $cxl_port->{decoders}[$hid],
            $cxl_port->{daxs}[$hid]->{name},
            $cxl_port->{daxs}[$hid]->{mode},
            $cxl_port->{regions}[$hid],
        );

        if ($dax && $dax ne "dax<?>") {
            # has dax, but not has endpoint or decoder
            if ($port eq "endpoint<?>" || $port eq "port<?>" || $decoder eq "decoder<?>" || !$port || !$decoder) {
                #$decoder = "decoder<?>";
                $print_err = 1;
            } else {
                $print_ok = 1;
            }
        }

        my $hdm_r_str = sprintf("%lx-%lx", $base, $base + $size -1);
        my $hdm_sz_str = size_to_human_string($size);
        my $hdm_dpa_skip_sz_str = $skip ? "DpaSkipSz=" . size_to_human_string($skip) : "${GRAY}DpaSkipSz=0${RESET}";
        my $hdm_target_range_type = $target_range_type_str[($ctl >> 12) & 1];
        printf_prefix($is_memdev);
        printf "    ";

        if ($print_err) {
            printf("${RED}%-40s${RESET} ${RED}%-25s %-7s${RESET} ",
                sprintf("%s -> %s %s %s", $decoder, $region, $dax, $dax_mode), $hdm_r_str, $hdm_sz_str);
            if ($is_memdev) {
                printf("%s", $hdm_dpa_skip_sz_str);
            } else {
                dump_hb_iw_rp_targets(\@iw_rp_targets);
            }
            printf(" ${RED}ig=%d iw=%d${RESET} ", $ctl & 0xf, ($ctl & 0xf0) >> 4);
        } elsif ($print_ok) {
            printf("${GREEN}%-40s${RESET} ${ORANGE}%-25s %-7s${RESET} ",
                sprintf("%s -> %s %s %s", $decoder, $region, $dax, $dax_mode), $hdm_r_str, $hdm_sz_str);
            if ($is_memdev) {
                printf("%s", $hdm_dpa_skip_sz_str);
            } else {
                dump_hb_iw_rp_targets(\@iw_rp_targets, $ORANGE);
            }
            printf(" ${ORANGE}ig=%d iw=%d${RESET} ", $ctl & 0xf, ($ctl & 0xf0) >> 4);
        } else {
            printf("%-40s %-25s %-7s ", "$decoder ", $hdm_r_str, $hdm_sz_str);
            if ($is_memdev) {
                printf("%s", $hdm_dpa_skip_sz_str);
            } else {
                dump_hb_iw_rp_targets(\@iw_rp_targets);
            }
            printf(" ig=%d iw=%d ", $ctl & 0xf, ($ctl & 0xf0) >> 4);
        }

        my $uio = $cap & (1 << 13);
        printf("%s %s %s %s TgtType:%s %s %s%s%s%s\n",
            flag_to_color_str("LockOnCmt", $ctl, 8),
            flag_to_color_str("Cmt", $ctl, 9, $print_err ? $RED : ""),
            flag_to_color_str("Cmtted", $ctl, 10, $print_err ? $RED : ""),
            flag_to_color_str("ErrNotCmtted", $ctl, 11, $RED),
            $hdm_target_range_type,
            flag_to_color_str("Bi", $ctl, 13),
            !$uio ? "" : flag_to_color_str("Uio ", $ctl, 14),
            !$uio ? "" : num_to_color_str("Uig ", ($ctl >> 16) & 0xf),
            !$uio ? "" : num_to_color_str("Uiw ", ($ctl >> 20) & 0xf),
            !$uio ? "" : num_to_color_str("Isp ", ($ctl >> 24) & 0xf));
    }
}

sub clear_hdmdec_commit {
    my ($cxl_port, $hid) = @_;
    my $hdm_base = $cxl_port->{hdm_base};
    my $ctl_addr = $hdm_base + $hid * 0x20 + 0x20;

    my $desc = $cxl_port->{is_memdev} ?
    sprintf("%-30s: clear commit %s", "CXL Type3 Device $cxl_port->{mem}", $cxl_port->{decoders}[$hid]) :
    sprintf("%-30s: clear commit %s", "CXL Host Brdge $cxl_port->{port}", $cxl_port->{decoders}[$hid]);

    my $ctl = read_devmem($ctl_addr, 32);
    my $commit = ($ctl >> 9) & 1;
    my $committed = ($ctl >> 10) & 1;
    if ($commit || $committed) {
        write_devmem($ctl_addr, 32, $ctl & ~(1 << 9));

        my $start = int(time() * 1000);
        while (1) {
            $ctl = read_devmem($ctl_addr, 32);
            $commit = ($ctl >> 9) & 1;
            $committed = ($ctl >> 10) & 1;
            my $delta_ms = int(time() * 1000) - $start;
            if (!$commit && !$committed) {
                last;
            } elsif ($delta_ms > $COMMIT_TIMEOUT_MS) {
                printf("${RED}%s failed: clear decoder%d commit timeout %dms (%dms)${RESET}\n",
                    $desc, $hid, $delta_ms, $COMMIT_TIMEOUT_MS);
                exit 1;
            }
            sleep 0.001;
        }
    }

    my $gbl_ctl = read_devmem($hdm_base + 0x4, 32);
    if (($gbl_ctl >> 1) & 1) {
        write_devmem($hdm_base + 0x4, 32, $gbl_ctl & ~(1 << 1));
    }

    #write_devmem($hdm_base + $hid * 0x20 + 0x10, 32, 0),
    #write_devmem($hdm_base + $hid * 0x20 + 0x14, 32, 0),
    #write_devmem($hdm_base + $hid * 0x20 + 0x18, 32, 0);
    #write_devmem($hdm_base + $hid * 0x20 + 0x1c, 32, 0);

    sleep 5 if $zebu;
    printf("${GREEN}%s success${RESET}\n", $desc);
}

sub commit_hdmdec {
    my ($cxl_port, $hid, $ig, $iw, $base, $size) = @_;
    $base //= 0; $size //= 0;
    my $hdm_base = $cxl_port->{hdm_base};
    my $ctl_addr = $hdm_base + $hid * 0x20 + 0x20;

    my $desc = sprintf("%-30s: commit %s ig:${ig} iw:${iw} %s",
        $cxl_port->{is_memdev} ? "CXL Type3 Device $cxl_port->{mem}" : "CXL Host Bridge $cxl_port->{port}",
        $cxl_port->{decoders}[$hid],
        $size ? sprintf("base:%#lx size:%s", $base, size_to_human_string($size)) : "");

    my $ctl = read_devmem($ctl_addr, 32);
    write_devmem($ctl_addr, 32, ($ctl & ~0xff) | ($iw << 4) | $ig);
    $ctl = read_devmem($ctl_addr, 32);
    my ($_ig, $_iw) = ($ctl & 0xf, ($ctl & 0xf0) >> 4);
    if ($_ig != $ig || $_iw != $iw) {
        printf("${RED}%s failed: set ig iw mismatch!!!${RESET}\n", $desc);
        exit 1;
    }

    if ($size) {
        write_devmem($hdm_base + $hid * 0x20 + 0x10, 32, $base & hex("0xffffffff"));
        write_devmem($hdm_base + $hid * 0x20 + 0x14, 32, $base >> 32);
        write_devmem($hdm_base + $hid * 0x20 + 0x18, 32, $size & hex("0xffffffff"));
        write_devmem($hdm_base + $hid * 0x20 + 0x1c, 32, $size >> 32);
        my $_base_l = read_devmem($hdm_base + $hid * 0x20 + 0x10, 32);
        my $_base_h = read_devmem($hdm_base + $hid * 0x20 + 0x14, 32);
        my $_size_l = read_devmem($hdm_base + $hid * 0x20 + 0x18, 32);
        my $_size_h = read_devmem($hdm_base + $hid * 0x20 + 0x1c, 32);
        my $_base = ($_base_h << 32) | $_base_l;
        my $_size = ($_size_h << 32) | $_size_l;
        if ($_size != $size || $_base != $base) {
            printf("${RED}%s failed: set base sz mismatch, read_back: %#lx %#lx!!!${RESET}\n", $desc, $_base, $_size);
            exit 1;
        }
    }

    write_devmem($ctl_addr, 32, read_devmem($ctl_addr, 32) | (1 << 9));
    my $start = int(time() * 1000);
    while (1) {
        sleep 0.001;
        $ctl = read_devmem($ctl_addr, 32);
        if ($ctl & (1 << 11)) {
            printf("${RED}%s failed: commit error${RESET}\n", $desc);
            exit 1;
        }

        my $delta_ms = int(time() * 1000) - $start;
        if ($delta_ms > $COMMIT_TIMEOUT_MS) {
            printf("${RED}%s failed: commit timeout %dms (%dms)${RESET}\n",
                $desc, $delta_ms, $COMMIT_TIMEOUT_MS);
            exit 1;
        }

        last if $ctl & (1 << 10);
    }

    # global ctrl hdm en
    write_devmem($hdm_base + 0x4, 32, read_devmem($hdm_base + 0x4, 32) | (1 << 1));
    sleep 5 if $zebu;
    printf("${GREEN}%s success${RESET}\n", $desc);
    return 0;
}

sub init_hdmdec {
    my ($cxl_port) = @_;
    my $hdm_base = $cxl_port->{hdm_base};

    my $cap = read_devmem($hdm_base, 32);
    my $tmp = $cap & 0xf;
    my $hdm_cnt = 0;
    if ($tmp == 0) {
        $hdm_cnt = 1;
    } elsif ($tmp >= 1 && $tmp <= 8) {
        $hdm_cnt = 2 * $tmp;
    } elsif ($tmp >= 9 && $tmp <= 12) {
        $hdm_cnt = 4 * ($tmp - 8) + 16;
    } else {
        return;
    }
    $cxl_port->{hdm_cnt} = $hdm_cnt;

    $cxl_port->{decoders} = [];
    $cxl_port->{daxs} = [];
    $cxl_port->{regions} = [];

    # 扫描 sysfs 下的 decoder 目录
    my $port = $cxl_port->{port};
    my $cnt = 0;
    my @decoder_dirs = glob("/sys/bus/cxl/devices/${port}/decoder[0-9]*");
    foreach my $decoder_dir (@decoder_dirs) {
        next unless ($decoder_dir && -d $decoder_dir);

        my $dax = { name => "dax<?>", mode => "" };
        my $decoder = basename($decoder_dir);
        my $region = cat_sysfs_file("$decoder_dir/region");
        if ($region) {
            # TODO for multiple daxs
            my @dax_paths = glob("/sys/bus/cxl/devices/${region}/dax_region[0-9]*/dax[0-9]*");
            if (@dax_paths) {
                $dax->{name} = basename($dax_paths[0]);
                if (!-e "$dax_paths[0]/driver") {
                    $dax->{mode} = "<?>";
                } else {
                    my $driver = basename(readlink("$dax_paths[0]/driver"));
                    if ($driver eq "device_dax") {
                        $dax->{mode} = "devdax";
                    } elsif ($driver eq "kmem") {
                        $dax->{mode} = "system-ram";
                    }
                }
            }
        } else {
            $region = "region<?>";
        }

        push @{$cxl_port->{decoders}}, $decoder;
        push @{$cxl_port->{regions}}, $region;
        push @{$cxl_port->{daxs}}, $dax;
        $cnt++;
    }
    for (; $cnt < $hdm_cnt; $cnt++) {
        push @{$cxl_port->{decoders}}, "decoder<?>";
        push @{$cxl_port->{regions}}, "region<?>";
        push @{$cxl_port->{daxs}}, { name => "dax<?>", mode => "" };
    }
}

